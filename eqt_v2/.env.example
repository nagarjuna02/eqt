EQT_APP_URL=https://your-eqt-server.example.com

EQT_EMAIL_SMTP_HOST=smtp.office365.com
EQT_EMAIL_SMTP_PORT=587
EQT_EMAIL_USE_TLS=true
EQT_EMAIL_USERNAME=your_email@example.com
EQT_EMAIL_PASSWORD=your_app_password_or_smtp_password
EQT_EMAIL_FROM=your_email@example.com
EQT_EMAIL_TO=your_email@example.com
EQT_EMAIL_SUBJECT_PREFIX=EQT V2

EQT_EMAIL_DAY_OF_MONTH=1
EQT_EMAIL_SEND_TIME=08:00
EQT_EMAIL_CHECK_INTERVAL_MINUTES=60
